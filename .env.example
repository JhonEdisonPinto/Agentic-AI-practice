# API Keys (Obtener en los enlaces indicados)
# Google Gemini: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_VERIFICATION_MODEL=
# OpenAI (Opcional): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LangSmith (Opcional para tracing y monitoreo)
# Obtener en: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-normativa-laboral
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Configuración de Embeddings
# Opciones: local (gratis, sin API key), gemini, openai
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=normativa_laboral

# Configuración de Retrieval
RETRIEVAL_K=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# GraphDB / Knowledge Graph Configuration
# Activar para integrar ontologia OWL + consultas SPARQL en runtime
GRAPHDB_ENABLED=false
GRAPHDB_BASE_URL=http://localhost:7200
GRAPHDB_REPOSITORY=ontologia-laboral
GRAPHDB_USERNAME=
GRAPHDB_PASSWORD=
GRAPHDB_AUTH_MODE=auto
GRAPHDB_LOGIN_URL=
GRAPHDB_TOKEN=
